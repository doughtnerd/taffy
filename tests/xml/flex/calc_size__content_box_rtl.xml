<test name="calc_size__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" align-items="flex-start" width="400px" height="300px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(50% - 12px)" height="calc(100% - 20px)"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="min(25%, 60px)" height="clamp(10px, 10%, 20px)"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="max(10%, 30px)" height="calc(25% + 5px)"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="300">
      <node x="212" y="0" width="188" height="280"/>
      <node x="152" y="0" width="60" height="20"/>
      <node x="112" y="0" width="40" height="80"/>
    </node>
  </expectations>
</test>
