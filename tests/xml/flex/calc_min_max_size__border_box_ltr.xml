<test name="calc_min_max_size__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" width="400px" height="100px">
      <div direction="ltr" position="relative" flex-grow="1" height="10px" max-width="calc(25% + 10px)"/>
      <div direction="ltr" position="relative" flex-grow="1" height="10px" min-width="calc(50% + 10px)"/>
      <div direction="ltr" position="relative" flex-grow="1" height="10px" max-height="calc(5% - 1px)"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="0" y="0" width="95" height="10"/>
      <node x="95" y="0" width="210" height="10"/>
      <node x="305" y="0" width="95" height="4"/>
    </node>
  </expectations>
</test>
