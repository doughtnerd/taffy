<test name="calc_padding_margin__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" width="400px" height="300px">
      <div box-sizing="content-box" direction="ltr" position="relative" align-items="flex-start" width="400px" height="300px" padding-top="calc(5% + 2px)" padding-left="calc(5% + 2px)" padding-bottom="calc(5% + 2px)" padding-right="calc(5% + 2px)">
        <div box-sizing="content-box" direction="ltr" position="relative" width="100px" height="40px" margin-top="calc(5% + 6px)" margin-left="calc(10% - 10px)"/>
        <div box-sizing="content-box" direction="ltr" position="relative" width="50px" height="40px" margin-left="auto" margin-right="calc(2% + 1px)"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="300">
      <node x="0" y="0" width="400" height="344">
        <node x="48" y="46" width="100" height="40"/>
        <node x="320" y="22" width="50" height="40"/>
      </node>
    </node>
  </expectations>
</test>
