<test name="calc_trigonometric_and_exponential_functions__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start" width="400px" height="300px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="hypot(30%, 40px)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(25%)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(-25% + 150px)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(10%)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc((45deg / 1deg) * 1%)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc((30deg / 57.2958deg) * 100px)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(40% + 4px)" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="calc(30% - 2.71828px)" height="10px"/>
    </div>
  </input>
