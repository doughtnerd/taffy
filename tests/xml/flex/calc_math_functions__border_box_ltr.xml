<test name="calc_math_functions__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-items="flex-start" width="400px" height="300px">
      <div direction="ltr" position="relative" width="round(up, 33%, 10px)" height="10px"/>
      <div direction="ltr" position="relative" width="mod(30%, 50px)" height="10px"/>
      <div direction="ltr" position="relative" width="rem(30%, 50px)" height="10px"/>
      <div direction="ltr" position="relative" width="abs(-25%)" height="10px"/>
      <div direction="ltr" position="relative" width="calc(40px * sign(5%))" height="10px"/>
      <div direction="ltr" position="relative" width="calc((10% / 1px) * 2px)" height="10px"/>
      <div direction="ltr" position="relative" width="min(50%, 150px)" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="300">
      <node x="0" y="0" width="140" height="10"/>
      <node x="0" y="10" width="20" height="10"/>
      <node x="0" y="20" width="20" height="10"/>
      <node x="0" y="30" width="100" height="10"/>
      <node x="0" y="40" width="40" height="10"/>
      <node x="0" y="50" width="80" height="10"/>
      <node x="0" y="60" width="150" height="10"/>
    </node>
  </expectations>
</test>
